; ================================================================
; Slate - configuracao do usuario
; Edite a vontade; depois: botao direito no skin > Refresh skin
; (ou rode deploy.ps1 de novo)
; ================================================================

[Variables]
; --- Clima (Open-Meteo - gratis, sem API key) ---
Latitude=40.4168
Longitude=-3.7038
LocationName=Madrid
UnitTemp=C

; --- World Clock ---
WorldCity=Sao Paulo
WorldTZ=-3

; --- Cores (R,G,B,A - paleta Retro-Futurista / Cyber-Sage) ---
AccentColor=110,185,172
AccentFill=110,185,172,42
CardColor=26,28,34,210
CardStroke=255,255,255,9
CardBevel=255,255,255,20
GraphBorder=255,255,255,36
TextPrimary=242,245,250,255
TextSecondary=195,202,214,235
TextFaint=155,164,178,200
BarTrack=255,255,255,54

; --- Fontes estaticas nativas (C:\Windows\Fonts - retro-futurista) ---
; Oxanium: geometrica quadrada sci-fi; Geist Mono: valores/metricas
FontMain=Oxanium
FontMedium=Oxanium Medium
FontBold=Oxanium SemiBold
FontClock=Oxanium Medium
FontMono=Geist Mono Medium

; --- Hardware ---
GPUTotalMB=12282
