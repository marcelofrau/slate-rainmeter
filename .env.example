# ================================================================
# Slate Work Profile — Local Environment Template
# Copy this file to `.env` (or `%APPDATA%\Rainmeter\SlateWork\.env`)
# `.env` is git-ignored so corporate URLs and tokens never enter Git.
# ================================================================

# Jira Server / Data Center base URL and personal access token
JIRA_URL=https://jira.example.com
# JIRA_PERSONAL_TOKEN=your_token_here

# Confluence Server / Data Center base URL and personal access token
CONFLUENCE_URL=https://confluence.example.com
# CONFLUENCE_PERSONAL_TOKEN=your_token_here

# FinOps / AI Spend dashboard URL (opened when clicking the Claude Spend card)
FINOPS_DASHBOARD_URL=https://finops.example.com/ai-cost-data/

# Optional custom path to the internal AI CLI binary (defaults to ~/Apps/bin/adi-aie.exe)
# AI_COST_CLI=C:\Users\youruser\Apps\bin\adi-aie.exe
